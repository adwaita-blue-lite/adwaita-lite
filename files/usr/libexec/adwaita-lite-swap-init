#!/bin/bash
# Creates /var/swap on first boot using the size recorded in /var/lib/adwaita-lite/swap-size.
# Called by adwaita-lite-swap-init.service.

set -euo pipefail

SWAPFILE=${SWAPFILE:-/var/swap}
SIZE_FILE=${SIZE_FILE:-/var/lib/adwaita-lite/swap-size}
MIN_SWAP_GB=1
MAX_SWAP_GB=256

if [ ! -r "$SIZE_FILE" ]; then
    echo "adwaita-lite-swap-init: missing swap size file: $SIZE_FILE" >&2
    exit 1
fi

size_gb=$(cat "$SIZE_FILE")
case "$size_gb" in
    ''|*[!0-9]*)
        echo "adwaita-lite-swap-init: swap size must be a whole number from ${MIN_SWAP_GB} to ${MAX_SWAP_GB} GB" >&2
        exit 1
        ;;
esac
if [ "${#size_gb}" -gt 3 ]; then
    echo "adwaita-lite-swap-init: swap size must be a whole number from ${MIN_SWAP_GB} to ${MAX_SWAP_GB} GB" >&2
    exit 1
fi
size_gb=$((10#$size_gb))
if [ "$size_gb" -lt "$MIN_SWAP_GB" ] || [ "$size_gb" -gt "$MAX_SWAP_GB" ]; then
    echo "adwaita-lite-swap-init: swap size must be a whole number from ${MIN_SWAP_GB} to ${MAX_SWAP_GB} GB" >&2
    exit 1
fi

# The swap file is attached through a loop device and dm-crypt, then swapon
# is called on the mapper. No filesystem-specific nocow flag is required.
touch "$SWAPFILE"

# fallocate is instant; fall back to dd on filesystems that don't support it.
if ! fallocate -l "${size_gb}G" "$SWAPFILE" 2>/dev/null; then
    dd if=/dev/zero of="$SWAPFILE" bs=1M count=$(( size_gb * 1024 )) status=none
fi

chmod 600 "$SWAPFILE"
