#!/bin/bash
# First-boot configuration for installer-deployed Adwaita-Lite systems.
# Reads /var/lib/adwaita-lite/install-config.json and performs operations
# that require the running target system: swap unit reconciliation and
# runtime zswap activation.
#
# Called by adwaita-lite-first-boot.service.
# Guards: runs only when install-config.json exists and setup-done does not.

set -euo pipefail

CONFIG=/var/lib/adwaita-lite/install-config.json
STATE_DIR=/var/lib/adwaita-lite

# Defense-in-depth against systemd's ConditionPathExists=!$STATE_DIR/
# setup-done getting silently skipped on some boots (same class of
# bug that drops Wants= edges from unit configs). If the stamp file
# exists we've already run; exit cleanly regardless of whether systemd
# honored its own condition.
if [ -e "$STATE_DIR/setup-done" ]; then
    exit 0
fi

# Likewise, bail if the install config isn't present — anaconda's
# kickstart now seeds it, and the wizard does too, but on any system
# that reaches this point without one, there's nothing to reconcile.
if [ ! -e "$CONFIG" ]; then
    exit 0
fi

# --- Read config via Python (already available in the image) ---
# Validate JSON once up front; a truncated file from a power loss mid-install
# would otherwise crash every `read_config` call and, under `set -e`, take
# the service down without writing `setup-done` (infinite boot-loop).
if ! python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$CONFIG" 2>/dev/null; then
    echo "adwaita-lite-first-boot: $CONFIG is malformed; skipping auto-setup." >&2
    echo "Re-run manually once the file is repaired." >&2
    exit 0
fi

read_config() {
    python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d.get(sys.argv[2], ''))" \
        "$CONFIG" "$1"
}

strategy=$(read_config memory_strategy)
swap_gb=$(read_config swap_size_gb)
username=$(read_config username)

# --- Memory management ---
if [ "$strategy" = "zswap" ] && [ -n "$swap_gb" ] && [ "$swap_gb" != "None" ]; then
    # Write swap size for the swap-init service. The installer already
    # enables the swap units in the target sysroot so swap.target can own
    # the lifecycle on the first installed boot; this start is idempotent
    # and covers retries or older installs where the transaction has not
    # already run.
    echo "$swap_gb" > "$STATE_DIR/swap-size"

    if ! systemctl start \
        adwaita-lite-swap-init.service \
        adwaita-lite-zswap.service \
        adwaita-lite-encrypted-swap.service; then
        echo "adwaita-lite-first-boot: encrypted swap activation failed;" \
             "continuing without disk swap." >&2
    fi

    # Swappiness sysctl and zram-generator.conf are already written to the
    # sysroot by the wizard during _step_configure_memory — no need to
    # write them again here (shell redirects can fail on ostree/SELinux).
    sysctl -w vm.swappiness=100 || true
fi
# zram: no action needed — zram-generator.conf (125%) is already in the image

# --- Greeter prefill ---
if [ -n "$username" ]; then
    echo "$username" > "$STATE_DIR/last-user"
fi

# --- Mark setup complete ---
touch "$STATE_DIR/setup-done"
