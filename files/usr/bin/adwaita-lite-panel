#!/usr/bin/env python3
"""Generate an sfwbar config/CSS preview from Adwaita-Lite settings.

The preview path never changes the Waybar default. It writes sfwbar assets to
a runtime or user config directory and launches/reloads sfwbar explicitly.

Usage:
  adwaita-lite-panel generate --output-dir DIR
  adwaita-lite-panel preview [--replace-waybar]
  adwaita-lite-panel apply
  adwaita-lite-panel restore
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

_SCRIPT_PATH = Path(__file__).resolve()
_LIB_ROOT = Path("/usr/lib")
if not _LIB_ROOT.joinpath("adwaita-lite/theme.py").exists():
    _LIB_ROOT = _SCRIPT_PATH.parents[1] / "lib"
sys.path.insert(0, str(_LIB_ROOT / "adwaita-lite"))

from theme import load_palette, normalize_accent, normalize_theme  # noqa: E402

SETTINGS_PATH = Path.home() / ".config/adwaita-lite/settings.json"
DEFAULTS_PATH = Path("/usr/share/adwaita-lite/defaults/settings.json")
PALETTE_PATHS = (
    Path("/usr/share/adwaita-lite/palette.json"),
    _SCRIPT_PATH.parents[1] / "share/adwaita-lite/palette.json",
)

STATUS_MODULES = ("pulseaudio", "backlight", "battery", "clock")
SUPPORTED_MODULES = ("custom/launcher", "wlr/taskbar", "tray", *STATUS_MODULES)
DEFAULT_LAYOUT = {
    "start": ["custom/launcher"],
    "center": ["wlr/taskbar"],
    "end": ["pulseaudio", "backlight", "battery", "clock", "tray"],
}
LAUNCHER_COMMAND = "/usr/bin/adwaita-lite-app-menu"
BATTERY_LEVELS = tuple(range(90, -1, -10))


def load_settings() -> dict:
    settings: dict = {}
    for path in (DEFAULTS_PATH, SETTINGS_PATH):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if isinstance(data, dict):
            settings.update(data)
    return settings


def _rgb(hex_color: str) -> tuple[int, int, int]:
    value = hex_color.lstrip("#")
    return (int(value[0:2], 16), int(value[2:4], 16), int(value[4:6], 16))


def _rgba(hex_color: str, alpha: float) -> str:
    r, g, b = _rgb(hex_color)
    return f"rgba({r}, {g}, {b}, {alpha:.2f})"


def _is_light(hex_color: str) -> bool:
    r, g, b = _rgb(hex_color)
    return (0.299 * r + 0.587 * g + 0.114 * b) > 186


def build_tokens(settings: dict) -> dict:
    palette = load_palette(PALETTE_PATHS)
    high_contrast = bool(settings.get("high_contrast", False))
    theme = normalize_theme(settings.get("theme"), high_contrast=high_contrast)
    if settings.get("panel_twilight", False) and not high_contrast:
        theme = "dark" if theme == "light" else "light"

    accent_name = normalize_accent(settings.get("accent"), palette)
    accent_hex = palette["accents"][accent_name]
    base = palette[theme]
    surface = base["window_bg"]
    fg = base["fg"]
    secondary_fg = base["secondary_fg"]
    is_light = _is_light(surface)
    border = _rgba(fg, 0.10 if is_light else 0.14)
    control = _rgba(fg, 0.10)
    control_hover = _rgba(fg, 0.15 if is_light else 0.16)
    control_border = _rgba(fg, 0.08 if is_light else 0.12)
    status_bg = _rgba(fg, 0.13 if is_light else 0.14)
    status_border = _rgba(fg, 0.14 if is_light else 0.18)
    tooltip_bg = base["card_bg"]
    tooltip_border = base["border"]
    tooltip_fg = base["fg"]

    alpha = 0.98 if high_contrast else 0.90
    if high_contrast:
        surface = "#000000"
        fg = "#ffffff"
        secondary_fg = "#ffffff"
        border = _rgba("#ffffff", 0.55)
        control = _rgba("#ffffff", 0.16)
        control_hover = _rgba("#ffffff", 0.26)
        control_border = _rgba("#ffffff", 0.45)
        status_bg = _rgba("#ffffff", 0.18)
        status_border = _rgba("#ffffff", 0.55)
        tooltip_bg = "#1d1d20"
        tooltip_border = "#ffffff"
        tooltip_fg = "#ffffff"

    try:
        font_size = int(settings.get("font_size", 11))
    except (TypeError, ValueError):
        font_size = 11
    scale = (font_size + 2) / 13
    compact = settings.get("density") == "compact"
    edge = settings.get("edge", "bottom")
    if edge not in ("top", "bottom", "left", "right"):
        edge = "bottom"
    vertical = edge in ("left", "right")

    size = round(((48 if compact else 64) if vertical else (40 if compact else 48)) * scale)
    return {
        "surface": _rgba(surface, alpha),
        "fg": fg,
        "secondary_fg": secondary_fg,
        "border": border,
        "control": control,
        "control_hover": control_hover,
        "control_border": control_border,
        "status_bg": status_bg,
        "status_border": status_border,
        "tooltip_bg": tooltip_bg,
        "tooltip_border": tooltip_border,
        "tooltip_fg": tooltip_fg,
        "accent": accent_hex,
        "font_size": font_size + 2,
        "scale": scale,
        "compact": compact,
        "edge": edge,
        "vertical": vertical,
        "size": size,
        "content": max(size - 4, 16),
        "icon": 16 if compact else 24,
        "spacing": round((6 if compact else 8) * scale),
        "margin": round(8 * scale),
        "inset": round(4 * scale),
        "pad_module": round(8 * scale),
        "pad_launcher": round(12 * scale),
        "pad_pin": round(8 * scale),
        "clock_24h": bool(settings.get("clock_24h", False)),
        "reduce_motion": bool(settings.get("reduce_motion", False)),
        "high_contrast": high_contrast,
        "theme": theme,
    }


def _escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


def _exec(action: str) -> str:
    return f'Exec("{_escape(action)}")'


def _pinned_buttons(settings: dict) -> list[str]:
    lines: list[str] = []
    for app in settings.get("pinned") or []:
        if not isinstance(app, dict):
            continue
        name = str(app.get("name") or "App")
        command = str(app.get("command") or "").strip()
        if not command:
            continue
        icon = str(app.get("icon") or "application-x-executable")
        lines.extend(
            [
                "  button {",
                '    style = "pinned"',
                f'    value = "{_escape(icon)}"',
                f'    tooltip = "{_escape(name)}"',
                f"    action[LeftClick] = {_exec(command)}",
                "  }",
            ]
        )
    return lines


def _layout_items(settings: dict) -> dict[str, list[str]]:
    layout = settings.get("layout")
    if not isinstance(layout, dict):
        layout = DEFAULT_LAYOUT
    sections: dict[str, list[str]] = {}
    for section in ("start", "center", "end"):
        raw = layout.get(section) or []
        if not isinstance(raw, list):
            raw = []
        sections[section] = [
            item for item in raw if isinstance(item, str) and item in SUPPORTED_MODULES
        ]

    pinned = [
        app
        for app in (settings.get("pinned") or [])
        if isinstance(app, dict) and str(app.get("command") or "").strip()
    ]
    if pinned:
        # Match the Waybar generator: insert pins after the launcher in
        # whichever section holds it, otherwise prepend to the start section.
        target = next(
            (section for section in ("start", "center", "end")
             if "custom/launcher" in sections[section]),
            None,
        )
        pins = [f"pin:{index}" for index in range(len(pinned))]
        if target:
            index = sections[target].index("custom/launcher") + 1
            sections[target][index:index] = pins
        else:
            sections["start"][:0] = pins
    return sections


def _battery_value() -> str:
    def lookup(suffix: str) -> str:
        parts = []
        for threshold in BATTERY_LEVELS:
            level = min(threshold + 10, 100)
            parts.append(f'{threshold}, "battery-level-{level}{suffix}-symbolic"')
        parts.append('"battery-level-0-symbolic"')
        return "Lookup(BatteryLevel, " + ", ".join(parts) + ")"

    return (
        'If(!BatteryLevel.count, "battery-missing-symbolic", '
        'If($BatteryStatus = "Charging", '
        f'{lookup("-charging")}, '
        f"{lookup('')}))"
    )


def _status_widget(item: str, tokens: dict) -> list[str]:
    if item == "clock":
        if tokens["clock_24h"]:
            formats = ["%H:%M"]
        elif tokens["vertical"]:
            formats = ["%I:%M", "%p"]
        else:
            formats = ["%I:%M %p"]
        lines: list[str] = []
        for fmt in formats:
            lines.extend(
                [
                    "    label {",
                    '      style = "clock"',
                    f'      value = Time("{fmt}")',
                    "      interval = 60000",
                    "    }",
                ]
            )
        return lines
    if item == "pulseaudio":
        return [
            "    button {",
            '      style = "volume"',
            '      trigger = "volume"',
            '      value = If(Volume("sink-mute"), "audio-volume-muted-symbolic", Lookup(Volume("sink-volume"), 66, "audio-volume-high-symbolic", 33, "audio-volume-medium-symbolic", "audio-volume-low-symbolic"))',
            '      tooltip = Str(Volume("sink-volume")) + "%"',
            '      action[4] = VolumeCtl "sink-volume +5"',
            '      action[5] = VolumeCtl "sink-volume -5"',
            '      action[LeftClick] = Exec("pavucontrol")',
            "    }",
        ]
    if item == "backlight":
        return [
            "    button {",
            '      style = If(BacklightMax.count, "backlight", "hidden")',
            "      interval = 5000",
            '      value = "display-brightness-symbolic"',
            '      tooltip = If(BacklightMax.count, Str(BacklightActual / BacklightMax * 100) + "%", "Backlight")',
            "    }",
        ]
    if item == "battery":
        return [
            "    button {",
            '      style = If(!BatteryLevel.count, "hidden", If(BatteryLevel < 12, "battery-critical", If(BatteryLevel < 25, "battery-warning", "battery")))',
            "      interval = 60000",
            f"      value = {_battery_value()}",
            '      tooltip = If(BatteryLevel.count, Str(BatteryLevel) + "%", "")',
            "    }",
        ]
    raise ValueError(item)


def _render_items(items: list[str], settings: dict, tokens: dict) -> list[str]:
    lines: list[str] = []
    index = 0
    while index < len(items):
        item = items[index]
        if item in STATUS_MODULES:
            run: list[str] = []
            while index < len(items) and items[index] in STATUS_MODULES:
                run.append(items[index])
                index += 1
            lines.extend(['  grid {', '    style = "status"'])
            for status_item in run:
                lines.extend(_status_widget(status_item, tokens))
            lines.append("  }")
            continue

        if item.startswith("pin:"):
            # Emit all pins at the first pin marker and skip the rest.
            while index < len(items) and items[index].startswith("pin:"):
                index += 1
            lines.extend(_pinned_buttons(settings))
            continue

        if item == "custom/launcher":
            lines.extend(
                [
                    "  button {",
                    '    style = "launcher"',
                    '    value = "view-app-grid-symbolic"',
                    '    tooltip = "Applications"',
                    f"    action[LeftClick] = {_exec(LAUNCHER_COMMAND)}",
                    "  }",
                ]
            )
        elif item == "wlr/taskbar":
            lines.extend(
                [
                    "  taskbar {",
                    '    style = "taskbar"',
                    "    icons = true",
                    "    labels = false",
                    "    filter = output",
                    "    cols = 1" if tokens["vertical"] else "    rows = 1",
                    "    action[LeftClick] = TaskbarItemDefault()",
                    "    action[MiddleClick] = Close()",
                    "  }",
                ]
            )
        elif item == "tray":
            lines.extend(
                [
                    "  tray {",
                    '    style = "tray"',
                    "    cols = 1" if tokens["vertical"] else "    rows = 1",
                    "  }",
                ]
            )
        index += 1
    return lines


def render_config(settings: dict, tokens: dict) -> str:
    sections = _layout_items(settings)
    if tokens["vertical"]:
        # sfwbar's GtkBox center widget stretches a lone taskbar item to the
        # full free height. Flow the center modules after start instead so
        # vertical task buttons keep their 1:1 aspect.
        sections["start"].extend(sections["center"])
        sections["center"] = []
    all_items = [item for section in ("start", "center", "end") for item in sections[section]]

    lines = ["#Api2", ""]

    if "pulseaudio" in all_items:
        lines.extend(['module("pulsectl")', ""])
    if "backlight" in all_items:
        lines.extend(
            [
                "scanner {",
                '  file("/sys/class/backlight/*/actual_brightness") { BacklightActual = Grab(Sum) }',
                '  file("/sys/class/backlight/*/max_brightness") { BacklightMax = Grab(Sum) }',
                "}",
                "",
            ]
        )
    if "battery" in all_items:
        lines.extend(
            [
                "scanner {",
                '  file("/sys/class/power_supply/BAT*/capacity") { BatteryLevel = Grab(Sum) }',
                '  file("/sys/class/power_supply/BAT*/status") { BatteryStatus = RegEx("^(.*)$") }',
                "}",
                "",
            ]
        )

    # The first layout block owns the bar properties. sfwbar beta16.1
    # rejects a top-level `bar` block, so the bar is addressed as a layout.
    lines.extend(
        [
            'layout "sfwbar" {',
            '  size = "100%"',
            f"  margin = {tokens['margin']}",
            '  layer = "top"',
            '  exclusive_zone = "auto"',
            '  mirror = "*"',
            '  style = "layout-start"',
        ]
    )
    lines.extend(_render_items(sections["start"], settings, tokens))
    lines.extend(["}", ""])

    for section in ("center", "end"):
        items = sections[section]
        if not items:
            continue
        lines.append(f'layout "sfwbar:{section}" {{')
        lines.append(f'  style = "layout-{section}"')
        lines.extend(_render_items(items, settings, tokens))
        lines.extend(["}", ""])

    return "\n".join(lines).rstrip() + "\n"


def _indicator(tokens: dict) -> str:
    return {
        "bottom": "border-bottom",
        "top": "border-top",
        "left": "border-left",
        "right": "border-right",
    }[tokens["edge"]]


def render_css(settings: dict, tokens: dict) -> str:
    motion = (
        "none"
        if tokens["reduce_motion"] or tokens["high_contrast"]
        else "background-color 120ms ease, border-color 120ms ease, color 120ms ease"
    )
    vertical = tokens["vertical"]
    content = tokens["content"]
    icon = tokens["icon"]
    pad_module = tokens["pad_module"]
    pad_launcher = tokens["pad_launcher"]
    pad_pin = tokens["pad_pin"]
    inset = tokens["inset"]
    inset_side = max(inset // 2, 1)
    direction = "bottom" if vertical else "right"
    indicator = _indicator(tokens)
    font = tokens["font_size"]

    if vertical:
        layout_padding = f"{inset}px {inset_side}px"
        label_padding = f"{pad_module}px 0"
        tray_padding = f"{pad_module}px 0"
        tray_box = f"min-width: {content}px;"
        launcher_box = f"min-width: {content}px;\n  min-height: {content}px;\n  padding: 0;"
        module_box = (
            f"min-width: {content}px;\n  min-height: {content}px;\n  padding: {pad_module}px 0;"
        )
        pin_box = f"min-width: {content}px;\n  min-height: {content}px;\n  padding: 0;"
        clock_extra = (
            f"\n  -GtkWidget-wrap: true;\n  -GtkWidget-max-width: {content}px;"
            "\n  -GtkWidget-align: 0.5;"
        )
        taskbar_extra = (
            "\n  -GtkWidget-row-homogeneous: false;"
            "\n  -GtkWidget-column-homogeneous: false;"
            "\n  -GtkWidget-valign: center;"
        )
        taskbar_button_extra = f"\n  -GtkWidget-max-height: {content}px;"
    else:
        layout_padding = f"0 {inset}px"
        label_padding = f"0 {pad_module}px"
        tray_padding = f"0 {pad_module}px"
        tray_box = f"min-height: {content}px;"
        launcher_box = f"min-height: {content}px;\n  padding: 0 {pad_launcher}px;"
        module_box = f"min-height: {content}px;\n  padding: 0 {pad_module}px;"
        pin_box = f"min-height: {content}px;\n  padding: 0 {pad_pin}px;"
        clock_extra = ""
        taskbar_extra = ""
        taskbar_button_extra = ""

    return f"""/* generated by adwaita-lite-panel; do not edit */
* {{
  font-family: "Roboto", "Adwaita Sans", sans-serif;
  font-size: {font}px;
  border: none;
  background-image: none;
  box-shadow: none;
  text-shadow: none;
}}
window#sfwbar {{
  -GtkWidget-direction: {tokens['edge']};
  background: {tokens['surface']};
  color: {tokens['fg']};
  border: 1px solid {tokens['border']};
  border-radius: 999px;
}}
#ebox, #revealer {{
  background: transparent;
}}
grid#layout-start, grid#layout-center, grid#layout-end {{
  padding: {layout_padding};
  -GtkWidget-direction: {direction};
}}
grid#layout-start {{ -GtkWidget-halign: start; }}
grid#layout-center {{ -GtkWidget-halign: center; }}
grid#layout-end {{ -GtkWidget-halign: end; }}
button#launcher {{
  {launcher_box}
  background: {tokens['control']};
  border: 1px solid {tokens['control_border']};
  border-radius: 999px;
  transition: {motion};
}}
button#launcher:hover {{
  background: {tokens['control_hover']};
}}
button#launcher image, button#pinned image, grid#status button image,
grid#taskbar button image {{
  min-width: {icon}px;
  min-height: {icon}px;
  -GtkWidget-halign: center;
  -GtkWidget-valign: center;
}}
button#pinned {{
  {pin_box}
  background: transparent;
  border: 1px solid transparent;
  border-radius: 999px;
  transition: {motion};
}}
button#pinned:hover {{
  background: {tokens['control_hover']};
  border-color: {tokens['control_border']};
}}
grid#taskbar {{
  -GtkWidget-direction: {direction};{taskbar_extra}
}}
grid#taskbar button {{
  {module_box}{taskbar_button_extra}
  background: transparent;
  border: 1px solid transparent;
  border-radius: 999px;
  transition: {motion};
}}
grid#taskbar button grid {{
  -GtkWidget-halign: center;
  -GtkWidget-valign: center;
}}
grid#taskbar button:hover {{
  background: {tokens['control_hover']};
  border-color: {tokens['control_border']};
}}
grid#taskbar button.focused {{
  {indicator}: 3px solid {tokens['accent']};
}}
grid#status {{
  background: {tokens['status_bg']};
  border: 1px solid {tokens['status_border']};
  border-radius: 999px;
  -GtkWidget-direction: {direction};
}}
grid#status button, grid#status label {{
  background: transparent;
  border: none;
  border-radius: 999px;
  transition: {motion};
}}
grid#status button {{
  {module_box}
}}
grid#status label {{
  padding: {label_padding};
}}
label#clock {{
  font-weight: 700;{clock_extra}
}}
grid#tray {{
  {tray_box}
  background: {tokens['control']};
  border: 1px solid {tokens['control_border']};
  border-radius: 999px;
  padding: {tray_padding};
}}
button#hidden, label#hidden {{
  -GtkWidget-visible: false;
}}
tooltip, tooltip label {{
  background: {tokens['tooltip_bg']};
  color: {tokens['tooltip_fg']};
  border: 1px solid {tokens['tooltip_border']};
  border-radius: 8px;
}}
"""


def write_assets(output_dir: Path, settings: dict | None = None) -> tuple[Path, Path]:
    settings = settings if settings is not None else load_settings()
    tokens = build_tokens(settings)
    output_dir.mkdir(parents=True, exist_ok=True)
    config = output_dir / "sfwbar.config"
    css = output_dir / "sfwbar.css"
    for path, text in ((config, render_config(settings, tokens)), (css, render_css(settings, tokens))):
        tmp = path.with_suffix(path.suffix + ".tmp")
        tmp.write_text(text, encoding="utf-8")
        tmp.replace(path)
    return config, css


def _sfwbar() -> str:
    return shutil.which("sfwbar") or "/usr/bin/sfwbar"


def _preview_dir() -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return Path(runtime) / "adwaita-lite/sfwbar-preview"


def _stop(name: str) -> None:
    subprocess.run(["pkill", "-x", name], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _preview_config_home() -> Path:
    """Build an isolated XDG config home that keeps GTK config intact.

    sfwbar 1.0~beta16.1 ignores -f/-c at runtime (it passes the original
    argv to g_application_run, which rejects the app options), so the only
    reliable entry point is its default config discovery. Symlinking the
    user's other config entries keeps gtk-3.0 settings and fonts working.
    """
    real = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    home = _preview_dir() / "home"
    home.mkdir(parents=True, exist_ok=True)
    if real.is_dir():
        for entry in real.iterdir():
            if entry.name == "sfwbar":
                continue
            link = home / entry.name
            if link.exists() or link.is_symlink():
                continue
            try:
                link.symlink_to(entry)
            except OSError:
                continue
    (home / "sfwbar").mkdir(parents=True, exist_ok=True)
    return home


def _launch(config_home: Path) -> None:
    env = os.environ.copy()
    env["XDG_CONFIG_HOME"] = str(config_home)
    subprocess.Popen(
        [_sfwbar()],
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    generate = sub.add_parser("generate", help="write config/CSS without launching")
    generate.add_argument("--output-dir", required=True, type=Path)

    preview = sub.add_parser("preview", help="launch sfwbar with generated assets")
    preview.add_argument(
        "--replace-waybar",
        action="store_true",
        help="stop the running Waybar before launching sfwbar",
    )

    sub.add_parser("apply", help="re-render preview assets and SIGHUP sfwbar")
    sub.add_parser("restore", help="stop sfwbar and start Waybar")

    args = parser.parse_args()

    if args.command == "generate":
        config, css = write_assets(args.output_dir)
        print(config)
        print(css)
        return 0

    if args.command == "preview":
        home = _preview_config_home()
        config, css = write_assets(home / "sfwbar")
        _stop("sfwbar")
        if args.replace_waybar:
            _stop("waybar")
        _launch(home)
        print(f"sfwbar preview: {config}")
        print(f"XDG_CONFIG_HOME={home}")
        if not args.replace_waybar:
            print("warning: Waybar was left running; use --replace-waybar for comparison")
        return 0

    if args.command == "apply":
        home = _preview_config_home()
        config, css = write_assets(home / "sfwbar")
        subprocess.run(["pkill", "-HUP", "-x", "sfwbar"], check=False)
        print(f"sfwbar assets: {config}")
        return 0

    if args.command == "restore":
        _stop("sfwbar")
        subprocess.Popen(
            ["waybar"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        print("Waybar restored")
        return 0

    return 1


if __name__ == "__main__":
    raise SystemExit(main())
