#!/usr/bin/env python3
"""Adwaita-Lite login greeter for greetd.

GTK4 greeter communicating with greetd via its IPC protocol.
Runs inside cage (Wayland kiosk compositor) launched by greetd.

Visual design: Adwaita palette, ChromeOS-inspired layout —
prominent clock, centered login card, single-user optimised.
"""

import configparser
import json
import os
import socket
import struct
import sys
from datetime import datetime
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, Gtk, Pango  # noqa: E402

import gettext
# Greeter shares the settings text domain — greeter-specific strings
# must be included in po/settings/*.po files.
gettext.bindtextdomain("adwaita-lite-settings", "/usr/share/locale")
gettext.textdomain("adwaita-lite-settings")
_ = gettext.gettext

APP_ID = "org.adwaitabluelite.Greeter"

LAST_USER_PATH = Path("/var/lib/greetd/last-user")
GREETER_THEME_PATH = Path("/var/lib/adwaita-lite/greeter-theme")
GREETER_ACCENT_PATH = Path("/var/lib/adwaita-lite/greeter-accent")
SESSIONS_DIR = Path("/usr/share/wayland-sessions")
PALETTE_PATH = Path("/usr/share/adwaita-lite/palette.json")

# ---------------------------------------------------------------------------
#  Adwaita palettes — loaded from shared palette.json, extended for greeter
# ---------------------------------------------------------------------------

def _load_accent_name() -> str:
    """Read the accent name apply-settings wrote to the shared /var/lib
    slot. The greeter runs pre-login without access to any user's home,
    so apply-settings propagates the choice via this file whenever the
    session script runs. Falls back to blue if the file is missing."""
    try:
        name = GREETER_ACCENT_PATH.read_text(encoding="utf-8").strip()
        if name:
            return name
    except OSError:
        pass
    return "blue"


def _hex_to_rgb(color: str) -> tuple[int, int, int] | None:
    color = color.strip().lstrip("#")
    if len(color) != 6:
        return None
    try:
        return tuple(int(color[i:i + 2], 16) for i in (0, 2, 4))
    except ValueError:
        return None


def _shade_hex(color: str, factor: float) -> str:
    rgb = _hex_to_rgb(color)
    if rgb is None:
        return color
    shaded = tuple(max(0, min(255, round(channel * factor))) for channel in rgb)
    return "#{:02x}{:02x}{:02x}".format(*shaded)


def _relative_luminance(color: str) -> float | None:
    rgb = _hex_to_rgb(color)
    if rgb is None:
        return None

    def channel(value: int) -> float:
        normalized = value / 255
        if normalized <= 0.04045:
            return normalized / 12.92
        return ((normalized + 0.055) / 1.055) ** 2.4

    r, g, b = (channel(value) for value in rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def _contrast_ratio(color_a: str, color_b: str) -> float:
    lum_a = _relative_luminance(color_a)
    lum_b = _relative_luminance(color_b)
    if lum_a is None or lum_b is None:
        return 0.0
    lighter = max(lum_a, lum_b)
    darker = min(lum_a, lum_b)
    return (lighter + 0.05) / (darker + 0.05)


def _accent_foreground(background: str) -> str:
    """Choose the higher-contrast text colour for an accent-filled control."""
    return max(("#ffffff", "#000000"), key=lambda color: _contrast_ratio(background, color))


def _load_palettes() -> dict:
    """Load base palette from shared JSON file and extend with greeter-specific tokens."""
    try:
        raw = json.loads(PALETTE_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        # Hardcoded fallback if palette.json is missing (should not happen)
        raw = {
            "light": {"window_bg": "#fafafa", "view_bg": "#ffffff",
                      "card_bg": "#ffffff", "fg": "#1e1e1e",
                      "secondary_fg": "#5e5c64", "border": "#d0d0d4"},
            "dark": {"window_bg": "#222226", "view_bg": "#1d1d20",
                     "card_bg": "#36363a", "fg": "#ffffff",
                     "secondary_fg": "#c0bfbc", "border": "#3a3a3e"},
            "accents": {"blue": "#3584e4", "red": "#e62d42"},
        }
    accent_name = _load_accent_name()
    accent = raw["accents"].get(accent_name) or raw["accents"].get("blue", "#3584e4")
    accent_hover_light = _shade_hex(accent, 1.1)
    accent_hover_dark = _shade_hex(accent, 1.15)
    accent_active = _shade_hex(accent, 0.85)
    error = raw["accents"].get("red", "#e62d42")
    # Adwaita-style elevation: three stacked layers - a hairline
    # outline that defines the card's edge even against a similar-
    # coloured surface, a tight key shadow that anchors the card, and
    # a broader ambient shadow for depth. Same structure in both
    # modes; only the alpha values change so the dark-mode shadow
    # reads on a dark bg without being pitch-black underneath.
    light_shadow = (
        "0 0 0 1px rgba(0, 0, 0, 0.10), "
        "0 1px 3px rgba(0, 0, 0, 0.10), "
        "0 6px 16px rgba(0, 0, 0, 0.14)"
    )
    dark_shadow = (
        "0 0 0 1px rgba(0, 0, 0, 0.30), "
        "0 1px 3px rgba(0, 0, 0, 0.35), "
        "0 6px 16px rgba(0, 0, 0, 0.45)"
    )
    return {
        "light": {
            **raw["light"],
            "entry_bg": raw["light"].get("view_bg", raw["light"]["card_bg"]),
            "accent": accent,
            "accent_fg": _accent_foreground(accent),
            "accent_hover": accent_hover_light,
            "accent_hover_fg": _accent_foreground(accent_hover_light),
            "accent_active": accent_active,
            "accent_active_fg": _accent_foreground(accent_active),
            "error": error,
            "hover": "rgba(0, 0, 0, 0.04)",
            "card_shadow": light_shadow,
        },
        "dark": {
            **raw["dark"],
            "entry_bg": raw["dark"].get("view_bg", "#1d1d20"),
            "accent": accent,
            "accent_fg": _accent_foreground(accent),
            "accent_hover": accent_hover_dark,
            "accent_hover_fg": _accent_foreground(accent_hover_dark),
            "accent_active": accent_active,
            "accent_active_fg": _accent_foreground(accent_active),
            "error": error,
            "hover": "rgba(255, 255, 255, 0.06)",
            "card_shadow": dark_shadow,
        },
    }

PALETTES = _load_palettes()


def _load_theme() -> str:
    try:
        theme = GREETER_THEME_PATH.read_text(encoding="utf-8").strip()
        if theme in PALETTES:
            return theme
    except OSError:
        pass
    return "light"


